---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlotFeature from '../components/PlotFeature.astro';
import content from '../content/site/plot.json';
---
<BaseLayout title={content.seo.title} description={content.seo.description} image={content.seo.image}>
  <div class="plot-landing">
    <section class="plot-hero plot-shell" aria-labelledby="plot-title">
      <div class="plot-hero__copy">
        <div class="plot-identity"><img src={content.hero.logo} alt="Bon Plot" width="52" height="52" /><span>{content.hero.status}</span></div>
        <p class="plot-eyebrow">{content.hero.eyebrow}</p><h1 id="plot-title">{content.hero.title}</h1>
        <p class="plot-lead">{content.hero.description}</p>
        <div class="plot-actions"><a class="plot-button" href="#workspace">{content.hero.primaryButton}</a><a class="plot-text-link" href="#about">{content.hero.secondaryButton} <span aria-hidden="true">→</span></a></div>
        <p class="plot-microcopy">{content.hero.meta}</p>
      </div>
      <figure class="plot-frame plot-hero__image"><img src={content.hero.image} alt={content.hero.imageAlt} width="1600" height="1000" fetchpriority="high" /></figure>
    </section>
    <section class="plot-problem plot-shell" id="writers" aria-labelledby="problem-title">
      <div><p class="plot-eyebrow">{content.problem.eyebrow}</p><h2 id="problem-title">{content.problem.title}</h2><p class="plot-description">{content.problem.description}</p></div>
      <ol class="plot-pain-points">{content.problem.points.map((point,index) => <li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span>{point}</li>)}</ol>
    </section>
    <section class="plot-showcase plot-shell" id="workspace" aria-labelledby="story-title">
      <div class="plot-intro"><p class="plot-eyebrow">{content.story.eyebrow}</p><h2 id="story-title">{content.story.title}</h2><p class="plot-description">{content.story.description}</p></div>
      <figure class="plot-frame"><img src={content.story.image} alt={content.story.imageAlt} width="1600" height="1000" loading="lazy" decoding="async" /></figure>
    </section>
    <div class="plot-shell"><PlotFeature id="manuscript" {...content.manuscript} /></div>
    <div class="plot-shell"><PlotFeature id="characters-world" {...content.world} reverse /></div>
    <div class="plot-shell"><PlotFeature id="checks" {...content.checks} /></div>
    <section class="plot-cta plot-shell" id="testing" aria-labelledby="cta-title">
      <p class="plot-eyebrow">{content.cta.eyebrow}</p><h2 id="cta-title">{content.cta.title}</h2><p class="plot-description">{content.cta.description}</p>
      <p class="plot-testing-status">{content.cta.status}</p><p class="plot-testing-note">{content.cta.note}</p>
      <a class="plot-button" href="#workspace">{content.cta.button}</a><p class="plot-microcopy">{content.cta.meta}</p>
    </section>
    <section class="plot-faq plot-shell" id="about" aria-labelledby="faq-title">
      <p class="plot-eyebrow">{content.faq.eyebrow}</p><h2 id="faq-title">{content.faq.title}</h2>
      <div>{content.faq.items.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>
  </div>
</BaseLayout>
<style>
  .plot-landing { background:#07141c; color:#f5f2eb; }
  .plot-shell { width:min(1240px,calc(100% - 96px)); margin-inline:auto; }
  .plot-landing section { scroll-margin-top:90px; }
  .plot-landing h1,.plot-landing h2 { color:#f5f2eb; font-family:var(--display); font-weight:400; line-height:1.06; letter-spacing:-.035em; }
  .plot-landing h1 { font-size:clamp(48px,4.4vw,64px); }
  .plot-landing h2 { max-width:620px; font-size:clamp(38px,3.7vw,54px); }
  .plot-eyebrow { margin:0 0 18px; color:#aab7c0; font-size:11px; font-weight:750; letter-spacing:.17em; text-transform:uppercase; }
  .plot-description { max-width:600px; margin-top:24px; color:#aab7c0; font-size:16px; line-height:1.75; }
  .plot-hero { display:grid; grid-template-columns:1.08fr .92fr; align-items:center; gap:clamp(40px,5vw,76px); min-height:656px; padding-block:83px 106px; }
  .plot-hero__copy { min-width:0; }
  .plot-identity { display:flex; align-items:center; gap:16px; margin-bottom:24px; }
  .plot-identity img { width:52px; height:52px; object-fit:contain; }
  .plot-identity span { color:#aab7c0; font-size:12px; }
  .plot-lead { max-width:560px; margin-top:26px; color:#aab7c0; font-size:17px; line-height:1.7; }
  .plot-actions { display:flex; flex-wrap:wrap; align-items:center; gap:24px; margin-top:30px; }
  .plot-button { display:inline-flex; align-items:center; justify-content:center; min-height:52px; padding:14px 24px; border:1px solid transparent; border-radius:6px; background:#ff7a45; color:#15100d; font-size:13px; font-weight:750; line-height:1.4; text-align:center; text-decoration:none; transition:background .2s ease; }
  .plot-button:hover { background:#ff9166; }
  .plot-text-link { display:inline-flex; gap:10px; align-items:center; min-height:44px; color:#c8d0d4; font-size:13px; text-decoration:none; }
  .plot-text-link:hover { color:#fff; text-decoration:underline; text-underline-offset:5px; }
  .plot-microcopy { margin-top:18px; color:#aab7c0; font-size:12px; line-height:1.6; }
  .plot-frame { overflow:hidden; margin:0; border:1px solid rgba(220,232,237,.18); border-radius:16px; background:#0c1c25; box-shadow:0 28px 70px rgba(0,0,0,.24); }
  .plot-frame img { display:block; width:100%; height:auto; aspect-ratio:16 / 10; object-fit:contain; }
  .plot-problem { display:grid; grid-template-columns:.9fr 1.1fr; align-items:center; gap:clamp(50px,8vw,118px); min-height:520px; padding-block:104px; }
  .plot-pain-points { margin:0; padding:0; list-style:none; }
  .plot-pain-points li { display:grid; grid-template-columns:30px 1fr; align-items:start; gap:24px; padding-block:26px; border-top:1px solid rgba(220,232,237,.13); font-family:var(--display); font-size:23px; line-height:1.35; }
  .plot-pain-points span { padding-top:5px; color:#aab7c0; font-family:var(--sans); font-size:10px; letter-spacing:.08em; }
  .plot-showcase { min-height:832px; padding-block:120px; }
  .plot-intro { max-width:650px; margin-bottom:54px; }
  .plot-cta { display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:608px; padding-block:128px; text-align:center; }
  .plot-cta h2 { max-width:810px; }
  .plot-cta .plot-description { max-width:710px; }
  .plot-testing-status { margin-top:34px; color:#f5f2eb; font-size:15px; font-weight:650; }
  .plot-testing-note { max-width:520px; margin-top:8px; color:#aab7c0; font-size:14px; line-height:1.7; }
  .plot-cta .plot-button { margin-top:24px; }
  .plot-faq { padding-block:96px 120px; }
  .plot-faq h2 { margin-bottom:36px; }
  .plot-faq details { border-top:1px solid rgba(220,232,237,.13); }
  .plot-faq details:last-child { border-bottom:1px solid rgba(220,232,237,.13); }
  .plot-faq summary { display:flex; align-items:center; justify-content:space-between; gap:24px; padding-block:24px; color:#f5f2eb; font-size:15px; cursor:pointer; list-style:none; }
  .plot-faq summary::-webkit-details-marker { display:none; }
  .plot-faq summary span { flex:0 0 20px; color:#aab7c0; font-size:24px; text-align:center; }
  .plot-faq details[open] summary span { transform:rotate(45deg); }
  .plot-faq details p { max-width:720px; padding:0 36px 26px 0; color:#aab7c0; font-size:15px; line-height:1.75; }
  @media(max-width:1000px) {
    .plot-shell { width:min(760px,calc(100% - 48px)); }
    .plot-hero,.plot-problem { grid-template-columns:1fr; min-height:0; gap:42px; padding-block:80px; }
    .plot-hero h1 { max-width:710px; font-size:clamp(48px,7vw,68px); }
    .plot-showcase { min-height:0; padding-block:80px; }
    .plot-intro { margin-bottom:36px; }
    .plot-cta { min-height:0; padding-block:100px; }
    .plot-faq { padding-block:70px 90px; }
  }
  @media(max-width:620px) {
    .plot-shell { width:calc(100% - 32px); }
    .plot-hero,.plot-problem,.plot-showcase { padding-block:64px; }
    .plot-hero { padding-top:48px; gap:36px; }
    .plot-hero h1 { font-size:clamp(34px,9.2vw,40px); }
    .plot-landing h2 { font-size:clamp(30px,9vw,36px); }
    .plot-lead { font-size:16px; }
    .plot-actions { gap:12px 20px; }
    .plot-eyebrow { font-size:10px; line-height:1.6; }
    .plot-pain-points li { gap:16px; padding-block:22px; font-size:21px; }
    .plot-cta { padding-block:80px; }
    .plot-faq { padding-block:64px 80px; }
    .plot-frame { border-radius:10px; }
  }
</style>
