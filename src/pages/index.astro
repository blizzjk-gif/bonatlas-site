---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../content/site/home.json';
---
<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image={content.seo.image}
>
  <section class="hero">
    <div class="hero-sky" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1><span>{content.hero.title}</span><em>{content.hero.accent}</em></h1>
      <p class="lede">{content.hero.description}</p>
      <div class="hero-stage">
        <a class="product-window product-window--atlas screen screen--atlas" href="/atlas">
          <span class="window-label">Bon Atlas</span>
          <img src={content.hero.atlasImage} alt="Редактор карты Bon Atlas" width="1800" height="1125" />
          <span class="route-anchor route-anchor--atlas" aria-hidden="true"></span>
        </a>
        <span class="story-route" aria-hidden="true"></span>
        <a class="product-window product-window--plot screen screen--plot" href="/plot">
          <span class="window-label">Bon Plot</span>
          <img src={content.hero.plotImage} alt="Книжный режим Bon Plot" width="1600" height="1000" />
          <span class="route-anchor route-anchor--plot" aria-hidden="true"></span>
        </a>
      </div>
      <div class="hero-actions">
        <a class="button" href="/atlas">{content.hero.atlasButton} <span>→</span></a>
        <a class="button button--plot" href="/plot">{content.hero.plotButton} <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section products" id="products">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">{content.products.eyebrow}</p><h2>{content.products.title}</h2></div>
        <p class="lede">{content.products.description}</p>
      </div>
      <div class="product-cards">
        <article class="product-card product-card--atlas">
          <div class="product-card__top">
            <img class="product-logo product-logo--atlas" src={content.products.atlas.logo} alt="Логотип Bon Atlas" />
            <span class="status">{content.products.atlas.status}</span>
          </div>
          <div class="product-card__copy"><p>{content.products.atlas.eyebrow}</p><h3>{content.products.atlas.title}</h3><a href="/atlas">{content.products.atlas.action} <span>↗</span></a></div>
          <div class="product-card__shot"><img src={content.products.atlas.image} alt="Готовая карта в Bon Atlas" loading="lazy" /></div>
        </article>
        <article class="product-card product-card--plot">
          <div class="product-card__top">
            <img class="product-logo product-logo--plot" src={content.products.plot.logo} alt="Логотип Bon Plot" />
            <span class="status">{content.products.plot.status}</span>
          </div>
          <div class="product-card__copy"><p>{content.products.plot.eyebrow}</p><h3>{content.products.plot.title}</h3><a href="/plot">{content.products.plot.action} <span>↗</span></a></div>
          <div class="product-card__shot"><img src={content.products.plot.image} alt="Персонажи в Bon Plot" loading="lazy" /></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section connection">
    <div class="container connection-grid">
      <div class="connection-copy"><span class="kicker-number">{content.connection.kicker}</span><h2>{content.connection.title}</h2><p class="lede">{content.connection.description}</p></div>
      <div class="connection-list">
        {content.connection.items.map((item) => <article><span>{item.label}</span><strong>{item.title}</strong><i>{item.product}</i></article>)}
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">{content.proof.eyebrow}</p><h2>{content.proof.title}</h2></div><p class="lede">{content.proof.description}</p></div>
      <div class="proof-grid">
        {content.proof.items.map((item) => <figure class="screen"><img src={item.image} alt={item.alt} loading="lazy" /><figcaption>{item.caption}</figcaption></figure>)}
      </div>
    </div>
  </section>

  <section class="section principles">
    <div class="container principles-grid">
      <div><p class="eyebrow">{content.principles.eyebrow}</p><h2>{content.principles.title}</h2></div>
      <div class="principle-list">
        {content.principles.items.map((item) => <article><span>{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="container closing-inner"><p class="eyebrow">{content.closing.eyebrow}</p><h2>{content.closing.title}</h2><div><a class="button" href="/atlas">{content.closing.atlasButton}</a><a class="button button--plot" href="/plot">{content.closing.plotButton}</a></div></div>
  </section>
</BaseLayout>

<script>
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  const route = stage?.querySelector<HTMLElement>('.story-route');
  const start = stage?.querySelector<HTMLElement>('.route-anchor--atlas');
  const end = stage?.querySelector<HTMLElement>('.route-anchor--plot');

  if (stage && route && start && end) {
    const moving = new Set<EventTarget>();
    let frame = 0;

    const updateRoute = () => {
      const origin = stage.getBoundingClientRect();
      // Zero-size anchors inherit the windows' complete perspective transforms.
      const a = start.getBoundingClientRect();
      const b = end.getBoundingClientRect();
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      route.style.left = `${a.x - origin.x}px`;
      route.style.top = `${a.y - origin.y}px`;
      route.style.width = `${Math.hypot(dx, dy)}px`;
      route.style.transform = `rotate(${Math.atan2(dy, dx)}rad)`;
      route.style.visibility = 'visible';
      frame = moving.size ? requestAnimationFrame(updateRoute) : 0;
    };

    const scheduleUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateRoute);
    };

    stage.querySelectorAll('.product-window').forEach((window) => {
      window.addEventListener('transitionrun', (event) => {
        if ((event as TransitionEvent).propertyName !== 'transform' || event.target !== window) return;
        moving.add(window);
        scheduleUpdate();
      });
      const finish = (event: Event) => {
        if ((event as TransitionEvent).propertyName !== 'transform' || event.target !== window) return;
        moving.delete(window);
        scheduleUpdate();
      };
      window.addEventListener('transitionend', finish);
      window.addEventListener('transitioncancel', finish);
    });

    const observer = new ResizeObserver(scheduleUpdate);
    observer.observe(stage);
    stage.querySelectorAll('.product-window').forEach((window) => observer.observe(window));
    scheduleUpdate();
  }
</script>

<style>
  .hero { position: relative; min-height: calc(100svh - 68px); padding: clamp(58px, 7vw, 104px) 0 70px; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-sky { position: absolute; inset: 0; background: radial-gradient(circle at 50% 38%, rgba(31,82,104,.58), transparent 31%), linear-gradient(180deg, rgba(4,10,16,.05), #071019 92%); }
  .hero-sky::after { content: ''; position: absolute; inset: 0; opacity: .16; background-image: url('/images/atlas/07-map-result.png'); background-size: cover; background-position: center; filter: saturate(.65) brightness(.52); mask-image: linear-gradient(to bottom, black, transparent 84%); }
  .hero-inner { position: relative; z-index: 1; text-align: center; }
  .hero h1 { display: grid; font-family: var(--display); font-weight: 400; }
  .hero h1 em { color: var(--plot); font-style: normal; }
  .hero .lede { margin: 20px auto 0; }
  .hero-stage { position: relative; height: clamp(360px, 43vw, 650px); margin-top: clamp(42px, 5vw, 72px); }
  .product-window { position: absolute; display: block; width: 55%; aspect-ratio: 16/10; color: var(--ink); text-decoration: none; transition: transform .35s ease; }
  .product-window:hover { z-index: 4; transform: translateY(-10px) rotate(0); }
  .product-window--atlas { top: 0; left: 0; transform: perspective(1400px) rotateY(4deg) rotate(-1deg); }
  .product-window--plot { right: 0; bottom: 0; transform: perspective(1400px) rotateY(-4deg) rotate(1deg); }
  .product-window img { object-position: top left; }
  .window-label { position: absolute; top: 16px; left: 16px; z-index: 3; padding: 7px 11px; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; background: rgba(4,10,16,.78); font-size: .72rem; font-weight: 800; backdrop-filter: blur(8px); }
  .route-anchor { position: absolute; width: 0; height: 0; pointer-events: none; }
  .route-anchor--atlas { left: 75%; top: 62%; }
  .route-anchor--plot { left: 22%; top: 35%; }
  .story-route { position: absolute; visibility: hidden; z-index: 5; height: 2px; pointer-events: none; transform-origin: 0 0; background: linear-gradient(90deg, var(--atlas), var(--plot)); box-shadow: 0 0 16px rgba(255,255,255,.45); }
  .story-route::before, .story-route::after { content: ''; position: absolute; top: 0; width: 9px; height: 9px; border: 2px solid currentColor; border-radius: 50%; background: var(--bg); transform: translate(-50%, -50%); } .story-route::before { left: 0; color: var(--atlas); } .story-route::after { left: 100%; color: var(--plot); }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .products { background: #08121a; }
  .product-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .product-card { position: relative; min-height: 680px; overflow: hidden; border: 1px solid var(--line); border-radius: 30px; background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.018)); }
  .product-card::before { content: ''; position: absolute; inset: -20% 40% 45% -20%; background: radial-gradient(circle, rgba(70,194,219,.16), transparent 67%); }
  .product-card--plot::before { inset: -20% -20% 45% 40%; background: radial-gradient(circle, rgba(255,126,80,.17), transparent 67%); }
  .product-card__top, .product-card__copy { position: relative; z-index: 2; padding-inline: clamp(24px, 4vw, 48px); }
  .product-card__top { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 34px; }
  .product-logo { width: 94px; height: 94px; object-fit: contain; }
  .product-logo--atlas { width: 110px; height: 110px; }
  .product-logo--plot { width: 110px; height: 110px; }
  .product-card__copy { margin-top: 18px; }
  .product-card__copy > p { color: var(--muted); font-size: .72rem; letter-spacing: .13em; text-transform: uppercase; }
  .product-card__copy h3 { max-width: 600px; margin-top: 10px; }
  .product-card__copy a { display: inline-flex; gap: 8px; margin-top: 24px; font-weight: 800; text-decoration: none; }
  .product-card--atlas .product-card__copy a { color: var(--atlas); } .product-card--plot .product-card__copy a { color: var(--plot); }
  .product-card__shot { position: absolute; right: 0; bottom: 0; left: 0; height: 47%; overflow: hidden; border-top: 1px solid var(--line); }
  .product-card__shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .5s ease; } .product-card:hover .product-card__shot img { transform: scale(1.025); }
  .connection { background: #050c12; }
  .connection-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(60px, 10vw, 150px); }
  .connection-copy h2 { max-width: 720px; }
  .connection-copy .lede { margin-top: 30px; }
  .connection-list { border-top: 1px solid var(--line); }
  .connection-list article { display: grid; grid-template-columns: 90px 1fr auto; align-items: center; gap: 22px; padding: 27px 0; border-bottom: 1px solid var(--line); }
  .connection-list span, .connection-list i { color: var(--muted); font-size: .75rem; font-style: normal; } .connection-list strong { font-size: 1rem; }
  .proof { overflow: hidden; }
  .proof-grid { display: grid; grid-template-columns: .9fr 1.1fr .9fr; gap: 20px; align-items: center; }
  .proof-grid figure { margin: 0; background: var(--surface); }
  .proof-grid figure:nth-child(2) { transform: translateY(-24px); }
  .proof-grid img { aspect-ratio: 16/10; object-position: top; }
  .proof-grid figcaption { padding: 17px 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; }
  .principles { border-block: 1px solid var(--line); background: linear-gradient(135deg, rgba(52,138,154,.11), rgba(255,119,72,.08)); }
  .principles-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(60px, 10vw, 150px); }
  .principle-list article { display: grid; grid-template-columns: 44px 210px 1fr; gap: 20px; padding: 27px 0; border-top: 1px solid var(--line); }
  .principle-list span { color: var(--plot); font-size: .72rem; } .principle-list h3 { font-size: 1.25rem; } .principle-list p { color: var(--muted); }
  .closing { text-align: center; }
  .closing-inner { display: grid; justify-items: center; }
  .closing h2 { max-width: 950px; }
  .closing-inner > div { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 38px; }
  @media (max-width: 900px) {
    .product-cards, .connection-grid, .principles-grid { grid-template-columns: 1fr; }
    .proof-grid { grid-template-columns: 1fr; } .proof-grid figure:nth-child(2) { transform: none; }
    .principle-list article { grid-template-columns: 40px 1fr; } .principle-list article p { grid-column: 2; }
  }
  @media (max-width: 680px) {
    .hero-stage { height: 580px; }
    .product-window { width: 92%; }
    .product-window--atlas { left: 0; } .product-window--plot { right: 0; bottom: 0; }
    .story-route { display: none; }
    .product-card { min-height: 610px; }
    .product-card__top { align-items: flex-start; }
    .connection-list article { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
