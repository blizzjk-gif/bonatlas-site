---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../content/site/atlas.json';
---
<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image={content.seo.image}
>
  <section class="product-hero atlas-hero">
    <div class="atlas-backdrop" style={`--backdrop-image: url('${content.hero.backgroundImage}')`} aria-hidden="true"></div>
    <div class="container product-hero__grid">
      <div class="product-hero__copy">
        <img class="brand-logo" src={content.hero.logo} alt="Логотип Bon Atlas" />
        <span class="status">{content.hero.status}</span>
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1>{content.hero.title}<br/><em>{content.hero.accent}</em></h1>
        <p class="lede">{content.hero.description}</p>
        <div class="actions"><a class="button" href="/atlas/app/">{content.hero.primaryButton}</a><a class="button button--ghost" href="#generator">{content.hero.secondaryButton}</a></div>
        <p class="meta">{content.hero.meta}</p>
      </div>
      <div class="screen screen--atlas hero-screen"><img src={content.hero.image} alt={content.hero.imageAlt} width="1800" height="1125" /></div>
    </div>
  </section>

  <nav class="feature-nav" aria-label="Возможности Bon Atlas"><div class="container"><a href="#generator"><span>01</span>Генерация</a><a href="#editing"><span>02</span>Редактор</a><a href="#assets"><span>03</span>Ассеты</a><a href="#styling"><span>04</span>Оформление</a><a href="#library"><span>05</span>Библиотека</a><a href="#result"><span>06</span>Экспорт</a></div></nav>

  <section class="section feature" id="generator">
    <div class="container feature-grid">
      <div class="feature-copy"><span class="kicker-number">{content.generator.kicker}</span><p class="eyebrow">{content.generator.eyebrow}</p><h2>{content.generator.title}</h2><p class="lede">{content.generator.description}</p><ul>{content.generator.bullets.map((item) => <li>{item}</li>)}</ul></div>
      <figure class="screen screen--atlas"><img src={content.generator.image} alt={content.generator.imageAlt} loading="lazy" /><figcaption>{content.generator.caption}</figcaption></figure>
    </div>
  </section>

  <section class="section feature feature--reverse" id="editing">
    <div class="container feature-grid">
      <div class="feature-copy"><span class="kicker-number">{content.editing.kicker}</span><p class="eyebrow">{content.editing.eyebrow}</p><h2>{content.editing.title}</h2><p class="lede">{content.editing.description}</p><ul>{content.editing.bullets.map((item) => <li>{item}</li>)}</ul></div>
      <figure class="screen screen--atlas"><img src={content.editing.image} alt={content.editing.imageAlt} loading="lazy" /><figcaption>{content.editing.caption}</figcaption></figure>
    </div>
  </section>

  <section class="section twin" id="assets">
    <div class="container">
      <div class="section-head"><div><span class="kicker-number">{content.assets.kicker}</span><p class="eyebrow">{content.assets.eyebrow}</p><h2>{content.assets.title}</h2></div><p class="lede">{content.assets.description}</p></div>
      <div class="twin-grid"><figure class="screen screen--atlas"><img src={content.assets.image} alt={content.assets.imageAlt} loading="lazy" /><figcaption>{content.assets.caption}</figcaption></figure><div class="twin-notes">{content.assets.notes.map((item) => <article><span>{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div>
    </div>
  </section>

  <section class="section styling" id="styling">
    <div class="container feature-grid">
      <div class="feature-copy"><span class="kicker-number">{content.styling.kicker}</span><p class="eyebrow">{content.styling.eyebrow}</p><h2>{content.styling.title}</h2><p class="lede">{content.styling.description}</p></div>
      <figure class="screen screen--atlas"><img src={content.styling.image} alt={content.styling.imageAlt} loading="lazy" /><figcaption>{content.styling.caption}</figcaption></figure>
    </div>
  </section>

  <section class="section library" id="library">
    <div class="container library-grid">
      <div><span class="kicker-number">{content.library.kicker}</span><p class="eyebrow">{content.library.eyebrow}</p><h2>{content.library.title}</h2><p class="lede">{content.library.description}</p></div>
      <figure class="screen screen--atlas"><img src={content.library.image} alt={content.library.imageAlt} loading="lazy" /></figure>
    </div>
  </section>

  <section class="section result" id="result">
    <div class="container"><div class="result-copy"><span class="kicker-number">{content.result.kicker}</span><p class="eyebrow">{content.result.eyebrow}</p><h2>{content.result.title}</h2><p class="lede">{content.result.description}</p></div><figure class="result-map"><img src={content.result.image} alt={content.result.imageAlt} loading="lazy" /></figure></div>
  </section>

  <section class="section product-cta"><div class="container"><img src={content.hero.logo} alt="Bon Atlas" /><p class="eyebrow">{content.cta.eyebrow}</p><h2>{content.cta.title}</h2><a class="button" href="/atlas/app/">{content.cta.button}</a></div></section>
</BaseLayout>

<style>
  .product-hero { position: relative; min-height: calc(100svh - 68px); display: grid; align-items: center; padding: clamp(72px, 8vw, 125px) 0; overflow: hidden; border-bottom: 1px solid var(--line); }
  .atlas-backdrop { position: absolute; inset: 0; opacity: .24; background: linear-gradient(90deg, #061018 18%, transparent 70%), var(--backdrop-image) center/cover; filter: brightness(.65) saturate(.75); }
  .atlas-backdrop::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 72% 48%, transparent, #061018 78%); }
  .product-hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: .72fr 1.28fr; align-items: center; gap: clamp(46px, 6vw, 92px); }
  .product-hero__copy { position: relative; }
  .brand-logo { width: 112px; height: 112px; margin-bottom: 24px; border-radius: 24px; object-fit: contain; background: #f9f4e8; }
  .product-hero .status { position: absolute; top: 4px; left: 130px; }
  .product-hero .eyebrow { color: var(--atlas); }
  .product-hero h1 { font-size: clamp(3.25rem, 6vw, 6.9rem); }
  .product-hero h1 em { color: var(--atlas); font-family: var(--display); font-weight: 400; font-style: normal; }
  .product-hero .lede { margin-top: 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .meta { margin-top: 24px; color: var(--muted); font-size: .74rem; }
  .hero-screen { aspect-ratio: 16/10; transform: perspective(1500px) rotateY(-3deg); }
  .hero-screen img { object-position: top; }
  .feature-nav { position: sticky; top: 68px; z-index: 30; border-bottom: 1px solid var(--line); background: rgba(7,16,25,.9); backdrop-filter: blur(16px); }
  .feature-nav .container { display: grid; grid-template-columns: repeat(6,1fr); }
  .feature-nav a { display: flex; gap: 9px; justify-content: center; padding: 18px 10px; color: var(--soft); font-size: .76rem; text-decoration: none; } .feature-nav a:hover { background: rgba(114,222,239,.07); color: var(--atlas); } .feature-nav span { color: #60717b; }
  .feature:nth-of-type(even) { background: #050d13; }
  .feature-grid { display: grid; grid-template-columns: .76fr 1.24fr; align-items: center; gap: clamp(54px, 8vw, 120px); }
  .feature--reverse .feature-copy { order: 2; }
  .feature-copy h2 { max-width: 690px; }
  .feature-copy .lede { margin-top: 28px; }
  .feature-copy ul { display: grid; gap: 12px; margin: 32px 0 0; padding: 24px 0 0; border-top: 1px solid var(--line); color: var(--muted); list-style: none; }
  .feature-copy li::before { content: '＋'; margin-right: 10px; color: var(--atlas); }
  figure { margin: 0; }
  figure img { aspect-ratio: 16/10; object-position: top; }
  figcaption { padding: 15px 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: .74rem; }
  .twin { background: linear-gradient(135deg, rgba(35,116,137,.13), transparent 58%); }
  .twin-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
  .twin-notes article { padding: 24px 0; border-top: 1px solid var(--line); }
  .twin-notes span { color: var(--atlas); font-size: .7rem; } .twin-notes h3 { margin-top: 8px; font-size: 1.35rem; } .twin-notes p { margin-top: 8px; color: var(--muted); }
  .styling { background: #050c12; }
  .library { border-block: 1px solid var(--line); }
  .library-grid { display: grid; grid-template-columns: .62fr 1.38fr; align-items: center; gap: clamp(52px, 8vw, 120px); }
  .library-grid .lede { margin-top: 28px; }
  .result { padding-bottom: 0; text-align: center; background: linear-gradient(180deg, #071019, #02070b); }
  .result-copy { display: grid; justify-items: center; margin-bottom: 54px; } .result-copy .lede { margin-top: 24px; }
  .result-map { overflow: hidden; border: 1px solid var(--line); border-bottom: 0; border-radius: 30px 30px 0 0; box-shadow: 0 -30px 110px rgba(47,151,177,.15); }
  .result-map img { width: 100%; aspect-ratio: auto; }
  .product-cta { text-align: center; }
  .product-cta .container { display: grid; justify-items: center; }
  .product-cta img { width: 112px; height: 112px; margin-bottom: 26px; border-radius: 24px; object-fit: contain; background: #f9f4e8; }
  .product-cta h2 { max-width: 930px; }
  .product-cta .button { margin-top: 34px; }
  @media (max-width: 1000px) { .product-hero__grid, .feature-grid, .twin-grid, .library-grid { grid-template-columns: 1fr; } .feature--reverse .feature-copy { order: 0; } .hero-screen { transform: none; } .feature-nav { overflow-x: auto; } .feature-nav .container { min-width: 720px; } }
  @media (max-width: 620px) { .brand-logo { width: 90px; height: 90px; } .product-hero .status { position: static; margin-bottom: 28px; } .product-hero h1 br { display: none; } }
</style>
