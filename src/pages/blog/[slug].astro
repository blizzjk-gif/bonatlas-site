---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { canonicalPath } from '../../lib/seo';
import imageVariants from '../../data/image-variants.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || process.env.SITE_ENV === 'dev' || !data.draft);
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(({ depth }) => depth === 2);
const published = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.publishedAt);
const pageUrl = new URL(canonicalPath(`/blog/${post.data.slug}`), Astro.site).href;
const pageTitle = post.data.title.includes('Bon Atlas') ? post.data.title : `${post.data.title} — Bon Atlas`;
const imageEntry = post.data.image ? (imageVariants as Record<string, { variants: Array<{ src: string }> }>)[post.data.image] : undefined;
const schemaImage = imageEntry?.variants.at(-1)?.src ?? post.data.image;
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.data.title, description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt && { dateModified: post.data.updatedAt.toISOString() }),
  ...(schemaImage && { image: new URL(schemaImage, Astro.site).href }),
  author: { '@type': 'Organization', name: post.data.author, url: Astro.site?.href },
  publisher: { '@type': 'Organization', name: 'Bon Atlas', url: Astro.site?.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  inLanguage: 'ru',
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: new URL('/blog/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
  ],
}];
---
<BaseLayout title={pageTitle} description={post.data.description} image={post.data.image} noindex={post.data.draft} structuredData={structuredData} article={{ published: post.data.publishedAt.toISOString(), modified: post.data.updatedAt?.toISOString() }}>
  <article>
    <header class="article-hero">
      <div class="container article-hero__inner">
        <nav class="back" aria-label="Хлебные крошки"><a href="/">Главная</a><span aria-hidden="true"> / </span><a href="/blog/">Блог</a></nav>
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <div class="meta">
          <span>{post.data.author}</span>
          {post.data.draft ? <span class="draft-label">Черновик для редакционного чтения</span> : <time datetime={post.data.publishedAt.toISOString()}>{published}</time>}
          {post.data.demo && <span>Демонстрационный материал</span>}
        </div>
        {post.data.image && <figure class:list={['article-cover', { 'article-cover--map': post.data.category === 'Карты' }]}><ResponsiveImage src={post.data.image} alt={post.data.imageAlt ?? ''} width="1672" height="941" sizes="(max-width: 900px) 100vw, 900px" fetchpriority="high" decoding="async" /></figure>}
      </div>
    </header>
    <div class="container article-layout">
      {sections.length > 0 && (
        <aside class="article-toc">
          <nav aria-label="Содержание статьи">
            <span>В статье</span>
            <ol>{sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
      <div class="article-main">
        <ArticleBody showSolutions={post.data.showSolutions} category={post.data.category} context={post.data.solutionsContext} articleSlug={post.data.slug}>
          <Content />
        </ArticleBody>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .article-hero { padding: 70px 0 78px; border-bottom: 1px solid var(--line); }
  .article-hero__inner { max-width: 900px; }
  .back { display: inline-block; margin-bottom: 60px; color: var(--muted); font-size: .82rem; text-decoration: none; }
  .back a { color: inherit; text-decoration: none; }
  .back a:hover { text-decoration: underline; }
  .article-hero h1 { font-size: clamp(2.4rem,5.3vw,4.5rem); }
  .article-hero .lede { margin-top: 28px; }
  .article-cover { margin: 40px 0 0; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
  .article-cover img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .article-cover--map { border: 0; border-radius: 0; }
  .article-cover--map img { display: block; aspect-ratio: auto; object-fit: contain; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 34px; color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  .article-layout { display: grid; grid-template-columns: 230px minmax(0, 700px); justify-content: center; gap: clamp(50px,8vw,110px); padding-block: clamp(65px,9vw,110px); }
  .article-layout aside { align-self: start; position: sticky; top: 92px; padding-top: 15px; border-top: 1px solid var(--ink); color: var(--muted); font-size: .78rem; }
  .article-layout aside span { color: var(--ink); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .article-layout aside p { margin-top: 12px; }
  .article-toc ol { margin: 18px 0 0; padding-left: 18px; }
  .article-toc li { margin: 0 0 12px; padding-left: 3px; }
  .article-toc a { color: var(--muted); text-decoration: none; }
  .article-toc a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .draft-label { color: var(--plot); }
  .prose { font-size: 1.06rem; }
  .article-main { min-width: 0; }
  .prose h2 { margin: 2.4em 0 .65em; font-size: clamp(1.6rem,2.7vw,2.2rem); scroll-margin-top: 100px; }
  .article-main > .prose:first-child > :is(h2, h3):first-child { margin-top: 0; }
  .prose h3 { margin: 2em 0 .6em; font-size: 1.6rem; }
  .prose p, .prose ul, .prose ol { margin: 1.15em 0; }
  .prose li { margin: .55em 0; }
  .prose blockquote { margin: 2em 0; padding: 22px 28px; border-left: 3px solid var(--rust); background: var(--rust-soft); font-family: var(--display); font-size: 1.25rem; }
  .prose a { color: var(--rust); text-underline-offset: 4px; }
  @media (max-width: 760px) { .article-layout { grid-template-columns: 1fr; } .article-layout aside { position: static; } }
</style>
