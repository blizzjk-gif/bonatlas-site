---
type Props = {
  kind: 'atlas' | 'plot';
  eyebrow: string;
  title: string;
  description: string;
  status: string;
  href: string;
  action: string;
};
const { kind, eyebrow, title, description, status, href, action } = Astro.props;
---
<article class:list={['product-card', `product-card--${kind}`]}>
  <div class="product-art" aria-hidden="true">
    {kind === 'atlas' ? (
      <svg viewBox="0 0 520 290" preserveAspectRatio="none">
        <path d="M-20 189C40 123 89 155 138 105S242 61 293 103s78 48 128 2 92-52 126-5" />
        <path d="M-10 230c59-72 132-28 178-86s112-71 167-18 118 25 199-50" />
        <path d="M48 283c39-66 89-54 120-24s70 20 101-29 88-44 124 3 80 31 142-28" />
        <circle cx="326" cy="130" r="6"/><circle cx="146" cy="156" r="4"/><path class="route" d="M146 156c47 30 112 22 180-26"/>
      </svg>
    ) : (
      <div class="plot-board"><span></span><span></span><span></span><i></i><i></i></div>
    )}
    <span class="art-label">Концептуальный плейсхолдер интерфейса</span>
  </div>
  <div class="product-copy">
    <div class="card-top"><span class="eyebrow">{eyebrow}</span><span class="status">{status}</span></div>
    <h3>{title}</h3>
    <p>{description}</p>
    <a href={href}>{action}<span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .product-card { overflow: hidden; border: 1px solid var(--line); border-radius: 28px; background: var(--white); }
  .product-art { position: relative; height: 300px; overflow: hidden; background: var(--forest-soft); }
  .product-card--plot .product-art { background: var(--rust-soft); }
  .product-art > svg { width: 100%; height: 100%; }
  .product-art path { fill: none; stroke: var(--forest); stroke-width: 2; opacity: .55; }
  .product-art circle { fill: var(--rust); }
  .product-art .route { stroke: var(--rust); stroke-dasharray: 5 7; }
  .art-label { position: absolute; right: 16px; bottom: 14px; padding: 5px 9px; border-radius: 999px; background: rgba(255,253,248,.78); color: var(--muted); font-size: .66rem; }
  .plot-board { position: absolute; inset: 38px 50px; }
  .plot-board span { position: absolute; width: 38%; height: 38%; border: 1px solid rgba(85, 42, 29, .2); border-radius: 11px; background: rgba(255,253,248,.72); box-shadow: 0 12px 30px rgba(92,48,31,.09); }
  .plot-board span::before, .plot-board span::after { content: ''; position: absolute; left: 16px; right: 16px; height: 3px; border-radius: 2px; background: rgba(85,42,29,.15); }
  .plot-board span::before { top: 18px; } .plot-board span::after { top: 30px; right: 38%; }
  .plot-board span:nth-child(1) { top: 0; left: 0; transform: rotate(-3deg); }
  .plot-board span:nth-child(2) { right: 0; bottom: 0; transform: rotate(3deg); }
  .plot-board span:nth-child(3) { top: 28%; left: 31%; transform: rotate(-1deg); }
  .plot-board i { position: absolute; height: 1px; background: rgba(169,81,53,.45); transform-origin: left; }
  .plot-board i:nth-of-type(1) { top: 30%; left: 25%; width: 42%; transform: rotate(18deg); }
  .plot-board i:nth-of-type(2) { top: 63%; left: 46%; width: 35%; transform: rotate(12deg); }
  .product-copy { padding: clamp(24px, 4vw, 38px); }
  .card-top { min-height: 42px; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .product-copy .eyebrow { margin-bottom: 8px; }
  .product-copy h3 { margin-top: 10px; }
  .product-copy > p { min-height: 78px; margin: 18px 0 26px; color: var(--muted); }
  .product-copy > a { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; font-weight: 800; text-decoration: none; }
  .product-copy > a:hover { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 520px) { .product-art { height: 220px; } .card-top { align-items: flex-start; flex-direction: column; } .product-copy > p { min-height: auto; } }
</style>
